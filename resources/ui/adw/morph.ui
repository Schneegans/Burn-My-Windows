<interface domain="burn-my-windows">

  <object class="AdwExpanderRow" id="morph-prefs">

    <child>
      <object class="AdwActionRow">
        <property name="title" translatable="yes">Animation Time [ms]</property>
        <child>
          <object class="GtkScale">
            <property name="valign">center</property>
            <property name="draw-value">1</property>
            <property name="digits">0</property>
            <property name="value-pos">left</property>
            <property name="width-request">300</property>
            <property name="adjustment">
              <object class="GtkAdjustment" id="morph-animation-time">
                <property name="upper">10000</property>
                <property name="lower">500</property>
                <property name="step-increment">10</property>
                <property name="page-increment">100</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="reset-morph-animation-time">
            <property name="icon-name">edit-clear-symbolic</property>
            <property name="valign">center</property>
            <property name="tooltip-text" translatable="yes">Reset to Default Value</property>
            <style>
              <class name="flat" />
            </style>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="AdwComboRow" id="morph-style">
        <property name="title" translatable="yes">Style</property>
        <property name="subtitle" translatable="yes">Liquid flow swirls the area into the window. Melt makes each image flow along its own edges.</property>
        <property name="model">
          <object class="GtkStringList">
            <items>
              <item translatable="yes">Liquid Flow</item>
              <item translatable="yes">Melt</item>
            </items>
          </object>
        </property>
        <child>
          <object class="GtkButton" id="reset-morph-style">
            <property name="icon-name">edit-clear-symbolic</property>
            <property name="valign">center</property>
            <property name="tooltip-text" translatable="yes">Reset to Default Value</property>
            <style>
              <class name="flat" />
            </style>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="AdwActionRow">
        <property name="title" translatable="yes">Strength</property>
        <child>
          <object class="GtkScale">
            <property name="valign">center</property>
            <property name="draw-value">1</property>
            <property name="digits">2</property>
            <property name="value-pos">left</property>
            <property name="width-request">300</property>
            <property name="adjustment">
              <object class="GtkAdjustment" id="morph-strength">
                <property name="upper">2.5</property>
                <property name="lower">0</property>
                <property name="step-increment">0.05</property>
                <property name="page-increment">0.25</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="reset-morph-strength">
            <property name="icon-name">edit-clear-symbolic</property>
            <property name="valign">center</property>
            <property name="tooltip-text" translatable="yes">Reset to Default Value</property>
            <style>
              <class name="flat" />
            </style>
          </object>
        </child>
      </object>
    </child>

  </object>

</interface>
