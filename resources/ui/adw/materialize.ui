<interface domain="burn-my-windows">

  <object class="AdwExpanderRow" id="materialize-prefs">

    <child>
      <object class="AdwActionRow">
        <property name="title" translatable="yes">Animation Time [ms]</property>
        <child>
          <object class="BurnMyWindowsSlider">
            <property name="valign">center</property>
            <property name="digits">0</property>
            <property name="width-request">300</property>
            <property name="adjustment">
              <object class="GtkAdjustment" id="materialize-animation-time">
                <property name="upper">3000</property>
                <property name="lower">100</property>
                <property name="step-increment">1</property>
                <property name="page-increment">100</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="reset-materialize-animation-time">
            <property name="icon-name">edit-clear-symbolic</property>
            <property name="valign">center</property>
            <property name="tooltip-text" translatable="yes">Reset to Default Value</property>
            <style>
              <class name="flat" />
            </style>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="AdwActionRow">
        <property name="title" translatable="yes">Start Scale</property>
        <child>
          <object class="BurnMyWindowsSlider">
            <property name="valign">center</property>
            <property name="digits">2</property>
            <property name="width-request">300</property>
            <property name="adjustment">
              <object class="GtkAdjustment" id="materialize-start-scale">
                <property name="upper">1</property>
                <property name="lower">0.1</property>
                <property name="step-increment">0.01</property>
                <property name="page-increment">0.1</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="reset-materialize-start-scale">
            <property name="icon-name">edit-clear-symbolic</property>
            <property name="valign">center</property>
            <property name="tooltip-text" translatable="yes">Reset to Default Value</property>
            <style>
              <class name="flat" />
            </style>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="AdwActionRow">
        <property name="title" translatable="yes">Steps</property>
        <property name="subtitle" translatable="yes">Zero gives a smooth animation.</property>
        <child>
          <object class="BurnMyWindowsSlider">
            <property name="valign">center</property>
            <property name="digits">0</property>
            <property name="width-request">300</property>
            <property name="adjustment">
              <object class="GtkAdjustment" id="materialize-steps">
                <property name="upper">12</property>
                <property name="lower">0</property>
                <property name="step-increment">1</property>
                <property name="page-increment">1</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="reset-materialize-steps">
            <property name="icon-name">edit-clear-symbolic</property>
            <property name="valign">center</property>
            <property name="tooltip-text" translatable="yes">Reset to Default Value</property>
            <style>
              <class name="flat" />
            </style>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="AdwActionRow">
        <property name="title" translatable="yes">Use System Accent Color</property>
        <property name="activatable-widget">materialize-use-accent-color</property>
        <child>
          <object class="GtkSwitch" id="materialize-use-accent-color">
            <property name="valign">center</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="reset-materialize-use-accent-color">
            <property name="icon-name">edit-clear-symbolic</property>
            <property name="valign">center</property>
            <property name="tooltip-text" translatable="yes">Reset to Default Value</property>
            <style>
              <class name="flat" />
            </style>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="AdwActionRow" id="materialize-color-row">
        <property name="title" translatable="yes">Color</property>
        <property name="activatable-widget">materialize-color</property>
        <child>
          <object class="GtkColorButton" id="materialize-color">
            <property name="use_alpha">1</property>
            <property name="show_editor">1</property>
            <property name="width-request">250</property>
            <property name="valign">center</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="reset-materialize-color">
            <property name="icon-name">edit-clear-symbolic</property>
            <property name="valign">center</property>
            <property name="tooltip-text" translatable="yes">Reset to Default Value</property>
            <style>
              <class name="flat" />
            </style>
          </object>
        </child>
      </object>
    </child>

  </object>

</interface>
